<%- include('../layout/main', { title: 'Create New Blog', body: '' }) %>

<div class="content-section">
    <h2 class="heading-primary">Create New Echo</h2>
    
    <div class="form-container">
        <form action="/blog" method="POST" data-validate>
            <div class="form-group">
                <label for="title" class="form-label">Echo Title *</label>
                <input 
                    type="text" 
                    name="title" 
                    id="title" 
                    class="form-input"
                    placeholder="Enter an engaging title for your echo..."
                    required
                    maxlength="100"
                >
            </div>

            <div class="form-group">
                <label for="body" class="form-label">Echo Content *</label>
                <textarea 
                    name="body" 
                    id="body" 
                    class="form-textarea"
                    placeholder="Share your thoughts, stories, and ideas here..."
                    oninput="autoResize(this)"
                    required
                    minlength="10"
                ></textarea>
                <small class="text-tertiary">Minimum 10 characters required</small>
            </div>

            <div class="form-group">
                <div class="flex justify-between items-center">
                    <a href="/blog" class="btn btn-secondary">
                        ← Back to Echoes
                    </a>
                    <button type="submit" class="btn btn-success">
                        📝 Publish Echo
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>