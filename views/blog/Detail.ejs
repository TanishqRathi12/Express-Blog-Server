<%- include('../layout/main', { title: blog.title, body: '' }) %>

<div class="content-section">
    <article class="card" style="max-width: 800px; margin: 0 auto;">
        <header class="mb-6">
            <h1 class="card-title" style="font-size: 2.5rem; margin-bottom: 1rem;">
                <%= blog.title %>
            </h1>
            <div class="text-tertiary mb-4">
                <small>
                    👤 By: <%= blog.author?.name || 'Anonymous' %> 
                    <% if (blog.createdAt) { %>
                        • 📅 <%= new Date(blog.createdAt).toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>
                    <% } %>
                </small>
            </div>
        </header>

        <div class="card-content">
            <div class="text-large" style="white-space: pre-wrap; line-height: 1.8;">
                <%= blog.body %>
            </div>
        </div>

        <footer class="card-actions mt-8" style="border-top: 1px solid var(--gray-200); padding-top: 1.5rem;">
            <a href="/blog" class="btn btn-secondary">
                ← All Echoes
            </a>
            
            <div class="flex gap-3">
                <a href="/blog/<%= blog._id %>/Update" class="btn btn-primary">
                    ✏️ Edit
                </a>
                
                <form action="/blog/<%= blog._id %>?_method=DELETE" method="POST" style="display: inline;">
                    <button 
                        type="submit" 
                        class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this echo? This action cannot be undone.')"
                    >
                        🗑️ Delete
                    </button>
                </form>
            </div>
        </footer>
    </article>

    <!-- Related Actions -->
    <div class="text-center mt-8">
        <div class="card" style="max-width: 600px; margin: 0 auto;">
            <h3 class="card-title text-center">Enjoyed this echo?</h3>
            <p class="card-content text-center">
                Check out more Echoes or share your own story with our community.
            </p>
            <div class="card-actions justify-center">
                <a href="/blog" class="btn btn-secondary">
                    📚 Browse More
                </a>
                <a href="/blog/new" class="btn btn-success">
                    ✍️ Write Your Own
                </a>
            </div>
        </div>
    </div>
</div>