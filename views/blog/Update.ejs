<%- include('../layout/main', { title: 'Edit Echo', body: '' }) %>

<div class="content-section">
    <h2 class="heading-primary">Edit Echo</h2>

    <div class="form-container">
        <form action="/blog/<%= blog._id %>?_method=PUT" method="POST" data-validate>
            <div class="form-group">
                <label for="title" class="form-label">Echo Title *</label>
                <input 
                    type="text" 
                    name="title" 
                    id="title" 
                    class="form-input"
                    value="<%= blog.title %>"
                    required
                    maxlength="100"
                >
            </div>

            <div class="form-group">
                <label for="body" class="form-label">Echo Content *</label>
                <textarea 
                    name="body" 
                    id="body" 
                    class="form-textarea"
                    oninput="autoResize(this)"
                    required
                    minlength="10"
                ><%= blog.body %></textarea>
                <small class="text-tertiary">Minimum 10 characters required</small>
            </div>

            <div class="form-group">
                <div class="flex justify-between items-center">
                    <a href="/blog/<%= blog._id %>" class="btn btn-secondary">
                        ← Back to Echo
                    </a>
                    <div class="flex gap-3">
                        <a href="/blog" class="btn btn-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            💾 Update Echo
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>